APP_ENV=development
# Required. Generate a unique random value of at least 32 characters.
SECRET_KEY=
# Required PostgreSQL connection string. Do not commit real credentials.
DATABASE_URL=postgresql://localhost/woodex_dev

# Allowed CORS origins (comma-separated).
# Defaults to development origins: http://localhost:3000,http://127.0.0.1:3000
# For production (e.g. Render backend with Vercel frontend), configure:
# ALLOWED_ORIGINS=https://woodex.vercel.app,https://www.example.com
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for signed product/category image uploads. Keep the API secret server-side.
CLOUDINARY_CLOUD_NAME=upgh5knm
CLOUDINARY_API_KEY=798864752568896
CLOUDINARY_API_SECRET=

# Production startup (build the frontend once before starting):
# cd frontend && npm run build
# cd .. && ./start.sh production
# Individual backend command: APP_ENV=production uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 2

# Required only for the explicitly destructive manual demo seeder.
WOODEX_ALLOW_DESTRUCTIVE_SEED=false
WOODEX_DEMO_PASSWORD=
