# Option A: full browser-facing API base, including /api/v1.
# Leave unset when using the recommended same-origin rewrite below.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Option B (recommended): backend origin used by the production Next server rewrite.
# Set this before `npm run build`; local development defaults to http://127.0.0.1:8000.
# BACKEND_API_URL=https://api.example.com

# Cloudinary credentials belong in the backend .env only. Never add
# CLOUDINARY_API_SECRET or expose it with a NEXT_PUBLIC_ prefix.
